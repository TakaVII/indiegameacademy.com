---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" noindex>
  <section class="section center">
    <div class="wrap">
      <img src="/brand/iga-crest-256.png" alt="" width="140" height="140" style="margin:0 auto var(--space-6)" />
      <h1>This quest has no map</h1>
      <p class="lead" style="margin:0 auto var(--space-8)">The page you're looking for moved or never existed. Try one of these instead.</p>
      <div class="row" style="justify-content:center">
        <a class="iga-btn iga-btn--primary" href="/">Home</a>
        <a class="iga-btn iga-btn--ghost" href="/programs/">Programs</a>
        <a class="iga-btn iga-btn--ghost" href="/blog/">Blog</a>
      </div>
    </div>
  </section>
</Base>
